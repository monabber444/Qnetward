# Qnetward Production Environment Configuration
POSTGRES_PASSWORD=netwatcher_secure_secret_password
POSTGRES_DB=netwatcher
POSTGRES_USER=netwatcher

# SeaweedFS / S3 Object Store Credentials
OBJECTSTORE_ACCESS_KEY=qnetward_admin_key
OBJECTSTORE_SECRET_KEY=qnetward_super_secret_access_key

# Public Host & Origins
NETWATCHER_PUBLIC_BASE_URL=http://localhost:8080
NETWATCHER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Demo Mode & Initial Credentials
NETWATCHER_DEMO_ENABLED=true
NETWATCHER_DEMO_NAME=Network Administrator
NETWATCHER_DEMO_EMAIL=admin@qnetward.internal

# Email / Resend Notification Keys (Optional for alert dispatch)
NETWATCHER_RESEND_API_KEY=
NETWATCHER_EMAIL_FROM=alerts@qnetward.internal
NETWATCHER_EMAIL_REPLY_TO=ops@qnetward.internal
